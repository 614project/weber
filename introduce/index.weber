// weber 소개 페이지 — 이 파일도 weber 로 쓰였습니다.
// 빌드: npm run site  (→ _site/index.html)

lang ko
title: "weber — 쌓아 올리면 웹이 됩니다"
viewport "width=device-width, initial-scale=1"
description "key { } 와 key: value 만으로 HTML, CSS, JS 를 함께 쓰는 웹 언어 weber"
theme-color "#6c4cf1"
icon favicon.svg
meta[property="og:title"][content="weber — 쌓아 올리면 웹이 됩니다"]
meta[property="og:description"][content="key { } 와 key: value 만으로 웹을 만드는 언어"]

// 머리글, 색, 코드 블록 스타일은 playground.weber 와 같습니다. 고칠 때 함께 고치세요.
style {
    :root {
        --bg #fbfaff
        --surface #ffffff
        --ink #1d1b2e
        --muted #625f78
        --line #e8e5f4
        --accent #6c4cf1
        --accent-ink #ffffff
        --accent-soft #efeaff
        --code-bg #19172b
        --code-ink #e9e7f5
        --code-line #2c2945
        --k-element #c3a6ff
        --k-attribute #ffb86b
        --k-css #5fd0ef
        --k-js #8fe388
        --t-string #e2d3a6
        --t-comment #8c88a8
        --mono ui-monospace, "SF Mono", "JetBrains Mono", D2Coding, Menlo, Consolas, monospace
        color-scheme light dark
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --bg #0f0e18
            --surface #17152a
            --ink #ecebf6
            --muted #a6a3bd
            --line #2a2742
            --accent #a28cff
            --accent-ink #160f33
            --accent-soft #241e44
            --code-bg #1b1930
            --code-line #302c4c
        }
    }

    * { box-sizing border-box }
    html { scroll-behavior smooth; scroll-padding-top 72px }
    body {
        margin 0
        background var(--bg)
        color var(--ink)
        font-family Pretendard, system-ui, -apple-system, "Apple SD Gothic Neo", "Noto Sans KR", sans-serif
        line-height 1.6
        word-break keep-all
        -webkit-font-smoothing antialiased
    }
    .wrap { max-width 1080px; margin 0 auto; padding 0 20px }

    header.site {
        position sticky
        top 0
        z-index 10
        background color-mix(in srgb, var(--bg) 85%, transparent)
        backdrop-filter blur(12px)
        border-bottom 1px solid var(--line)
        nav { display flex; align-items center; gap 24px; height 60px }
        .logo {
            display flex
            align-items center
            gap 8px
            color var(--ink)
            font-size 20px
            font-weight 800
            text-decoration none
            svg { color var(--accent) }
        }
        .links {
            display flex
            gap 20px
            margin-left auto
            a {
                color var(--muted)
                font-size 15px
                text-decoration none
                &:hover { color var(--ink) }
                &[aria-current=page] { color var(--accent); font-weight 600 }
            }
            @media (max-width: 560px) {
                gap 14px
                .section-link { display none }
            }
        }
    }

    .btn {
        display inline-flex
        align-items center
        gap 8px
        padding 12px 22px
        border 1px solid var(--line)
        border-radius 12px
        background var(--surface)
        color var(--ink)
        font-weight 600
        text-decoration none
        transition transform .15s, box-shadow .15s
        &:hover { transform translateY(-2px); box-shadow 0 8px 24px rgb(30 10 90 / 12%) }
        &.primary { background var(--accent); border-color var(--accent); color var(--accent-ink) }
    }

    pre.code {
        margin 0
        padding 18px 20px
        overflow auto
        border-radius 14px
        background var(--code-bg)
        color var(--code-ink)
        font 14px/1.65 var(--mono)
        tab-size 4
        &[data-label]::before {
            content attr(data-label)
            display block
            margin-bottom 8px
            color var(--t-comment)
            font-size 12px
            font-weight 700
            letter-spacing .08em
        }
    }
    .k-element { color var(--k-element) }
    .k-attribute { color var(--k-attribute) }
    .k-css { color var(--k-css) }
    .k-js { color var(--k-js) }
    .t-string { color var(--t-string) }
    .t-comment, .t-punct { color var(--t-comment) }
    .t-comment { font-style italic }
    .legend {
        display flex
        flex-wrap wrap
        gap 6px 16px
        color var(--t-comment)
        font-size 13px
        span::before {
            content ""
            display inline-block
            width 10px
            height 10px
            margin-right 6px
            border-radius 3px
            background currentColor
        }
    }
    code {
        padding .1em .4em
        border-radius 6px
        background var(--accent-soft)
        color var(--accent)
        font-family var(--mono)
        font-size .9em
    }

    .hero {
        display grid
        grid-template-columns 1.05fr 1fr
        gap 48px
        align-items center
        padding-top 88px
        padding-bottom 64px
        @media (max-width: 880px) { grid-template-columns 1fr; gap 36px; padding-top 48px }
        h1 { margin 20px 0; font-size clamp(40px, 6vw, 64px); line-height 1.12; letter-spacing -0.025em }
    }
    .eyebrow {
        display inline-block
        margin 0
        padding 4px 12px
        border-radius 999px
        background var(--accent-soft)
        color var(--accent)
        font-size 14px
        font-weight 600
    }
    .lead { max-width 34em; margin 0 0 32px; color var(--muted); font-size 18px }
    .actions { display flex; flex-wrap wrap; gap 12px }

    figure.window {
        margin 0
        overflow hidden
        border-radius 18px
        background var(--code-bg)
        box-shadow 0 30px 70px rgb(50 20 140 / 28%)
        .bar {
            display flex
            gap 7px
            padding 14px 18px
            border-bottom 1px solid var(--code-line)
            i { width 11px; height 11px; border-radius 50%; background #3b3758 }
        }
        pre.code { border-radius 0; background transparent }
        figcaption { padding 14px 20px; border-top 1px solid var(--code-line) }
        iframe { display block; width 100%; height 170px; border 0; background white }
    }

    .block { padding 72px 0 }
    .section-head {
        max-width 660px
        margin-bottom 32px
        h2 { margin 0 0 8px; font-size 32px; letter-spacing -0.015em }
        p { margin 0; color var(--muted) }
    }
    .compare, .pair, .start {
        display grid
        grid-template-columns 1fr 1fr
        gap 16px
        @media (max-width: 880px) { grid-template-columns 1fr }
    }
    // 긴 코드 줄이 그리드 칸을 넓히지 않도록
    .hero, .compare, .pair, .start {
        > * { min-width 0 }
    }

    .features {
        display grid
        grid-template-columns repeat(3, 1fr)
        gap 16px
        @media (max-width: 880px) { grid-template-columns 1fr 1fr }
        @media (max-width: 560px) { grid-template-columns 1fr }
    }
    .feature {
        padding 24px
        border 1px solid var(--line)
        border-radius 16px
        background var(--surface)
        h3 { margin 16px 0 6px; font-size 18px }
        p { margin 0; color var(--muted); font-size 15px }
    }
    .glyph {
        display inline-grid
        place-items center
        min-width 44px
        height 44px
        padding 0 10px
        border-radius 12px
        background var(--accent-soft)
        color var(--accent)
        font 700 15px var(--mono)
    }

    .samples { display grid; gap 40px }
    .sample {
        h3 { margin 0 0 4px; font-size 20px }
        p { margin 0 0 14px; color var(--muted) }
        pre:empty { display none }
        .open {
            display inline-block
            margin-top 10px
            color var(--accent)
            font-weight 600
            text-decoration none
            &:hover { text-decoration underline }
        }
    }

    .start {
        h3 { margin 0 0 10px; font-size 17px }
        pre + h3 { margin-top 20px }
    }

    footer.site {
        margin-top 40px
        padding 32px 0 56px
        border-top 1px solid var(--line)
        color var(--muted)
        font-size 14px
        .wrap { display flex; flex-wrap wrap; justify-content space-between; gap 8px 24px }
        a { color var(--accent) }
    }
}

header.site {
    nav.wrap {
        a.logo[href="./"] {
            svg {
                width 26
                height 26
                viewBox "0 0 24 24"
                fill currentColor
                aria-hidden true
                path: "M3 3.5h18v4.5H3zM5.5 10h13v4.5h-13zM8 16.5h8V21H8z"
            }
            "weber"
        }
        .links {
            a.section-link[href="#features"]: "특징"
            a.section-link[href="#syntax"]: "문법"
            a[href="playground.html"]: "플레이그라운드"
            a[href="https://github.com/614project/weber"]: "GitHub"
        }
    }
}

main {
    section.hero.wrap {
        div {
            p.eyebrow: "HTML · CSS · JS 를 한 문법으로"
            h1 { "쌓아 올리면,"; br; "웹이 됩니다." }
            p.lead {
                "weber 는 "
                code: "key { }"
                " 와 "
                code: "key: value"
                " 만으로 웹페이지를 만드는 언어입니다. 한 줄 한 줄이 요소인지, 속성인지, CSS 인지, 자바스크립트인지는 weber 가 알아서 판별합니다."
            }
            .actions {
                a.btn.primary[href="playground.html"]: "플레이그라운드에서 써보기 →"
                a.btn[href="#start"]: "설치하기"
            }
        }
        figure.window {
            .bar { i; i; i }
            pre#hero-code.code[data-weber] {
                `
                div.card {
                    class welcome
                    padding 20px
                    border-radius 14px
                    background #f4f1ff
                    h2: "안녕하세요, weber!"
                    button {
                        "눌러 보세요"
                        onclick {
                            this.textContent = '반가워요 👋'
                        }
                    }
                }
                `
            }
            figcaption.legend {
                span.k-element: "요소"
                span.k-attribute: "속성"
                span.k-css: "CSS"
                span.k-js: "JS"
            }
            iframe#hero-preview[title="위 코드의 결과"][sandbox="allow-scripts allow-modals"][hidden]
        }
    }

    section#compare.block.wrap {
        .section-head {
            h2: "구분하지 않고, 쌓기만"
            p: "HTML 에서는 속성, 스타일, 스크립트, 내용을 쓰는 자리가 모두 다릅니다. weber 에서는 전부 같은 모양의 한 줄입니다."
        }
        .compare {
            pre.code[data-html][data-label="HTML"] {
                `
                <div class="weber" style="font-size: 1rem">
                  <p>614project</p>
                  <button onclick="alert('hello')">click me!</button>
                  <script>
                    console.log("hello world!")
                  </script>
                </div>
                `
            }
            pre.code[data-weber][data-label="WEBER"] {
                `
                div {
                    class weber
                    font-size 1rem
                    p: "614project"
                    button {
                        "click me!"
                        onclick {
                            alert('hello')
                        }
                    }
                    script {
                        console.log("hello world!")
                    }
                }
                `
            }
        }
    }

    section#features.block.wrap {
        .section-head {
            h2: "특징"
            p: "적게 쓰고, 나머지는 weber 에게 맡기세요."
        }
        .features {
            article.feature {
                span.glyph: "?"
                h3: "알아서 판별"
                p { "문맥과 값을 보고 정합니다. "; code: "title"; " 은 head 안에서는 요소, 그 밖에서는 속성이 됩니다." }
            }
            article.feature {
                span.glyph: ".#[]"
                h3: "선택자 축약"
                p { code: "a.btn#go[href=/]"; " 처럼 CSS 선택자 모양 그대로 요소를 만듭니다." }
            }
            article.feature {
                span.glyph: "&"
                h3: "중첩 CSS"
                p { code: "style"; " 블록에서 Sass 처럼 중첩하면 평범한 CSS 로 펼쳐 줍니다. 쌍점과 세미콜론은 생략해도 됩니다." }
            }
            article.feature {
                span.glyph: ":hover"
                h3: "요소 안의 상태"
                p { "요소 안에 "; code: ":hover { }"; " 나 "; code: "@media { }"; " 를 쓰면 그 요소에만 적용됩니다." }
            }
            article.feature {
                span.glyph: "</>"
                h3: "문서 구조 자동 완성"
                p { code: "head"; ", "; code: "body"; ", "; code: "meta charset"; " 을 생략해도 알맞은 곳에 넣어 줍니다." }
            }
            article.feature {
                span.glyph: "!"
                h3: "친절한 오류"
                p: "줄과 칸, 코드 조각과 함께 알려 주고, 오타에는 비슷한 이름을 제안합니다."
            }
        }
    }

    section#syntax.block.wrap {
        .section-head {
            h2: "문법 한눈에"
            p: "아래 결과는 이 페이지에서 weber 컴파일러가 직접 변환한 것입니다."
        }
        .samples {
            .sample {
                h3: "한 줄에 하나씩 쌓기"
                p { "문장은 "; code: "키 { }"; ", "; code: "키: 값"; ", "; code: "키 값"; ", "; code: "\"텍스트\""; " 네 가지뿐입니다." }
                .pair {
                    pre.code[data-weber][data-label="WEBER"] {
                        `
                        section {
                            id intro
                            padding 16px
                            h2: "제목"
                            p { "글자는 따옴표로, "; b: "요소"; "는 이름으로." }
                        }
                        `
                    }
                    pre.code[data-output][data-label="HTML"]
                }
                a.open[href="playground.html"]: "플레이그라운드에서 열기 →"
            }
            .sample {
                h3: "이름이 같아도 알맞게"
                p: "정수 width 는 img 의 속성이 되고, 단위가 붙은 height 는 CSS 가 됩니다."
                .pair {
                    pre.code[data-weber][data-label="WEBER"] {
                        `
                        img {
                            src cat.png
                            title 고양이
                            width 120
                            height 50%
                        }
                        `
                    }
                    pre.code[data-output][data-label="HTML"]
                }
                a.open[href="playground.html"]: "플레이그라운드에서 열기 →"
            }
            .sample {
                h3: "선택자 축약"
                p: "태그를 생략하면 div 입니다."
                .pair {
                    pre.code[data-weber][data-label="WEBER"] {
                        `
                        a.btn#start[href="/docs"]: "시작하기"
                        .card { "카드" }
                        `
                    }
                    pre.code[data-output][data-label="HTML"]
                }
                a.open[href="playground.html"]: "플레이그라운드에서 열기 →"
            }
            .sample {
                h3: "요소 안의 :hover 와 @media"
                p: "요소에 클래스를 붙이고 규칙을 스타일시트로 옮겨 줍니다."
                .pair {
                    pre.code[data-weber][data-label="WEBER"] {
                        `
                        button {
                            "확인"
                            background white
                            :hover { background gold }
                            @media (max-width: 600px) {
                                width 100%
                            }
                        }
                        `
                    }
                    pre.code[data-output][data-label="HTML"]
                }
                a.open[href="playground.html"]: "플레이그라운드에서 열기 →"
            }
            .sample {
                h3: "문서 구조 자동 완성"
                p: "head 와 body 를 쓰지 않아도 알맞은 곳에 나눠 담습니다."
                .pair {
                    pre.code[data-weber][data-label="WEBER"] {
                        `
                        lang ko
                        title: "내 페이지"
                        h1: "안녕하세요"
                        `
                    }
                    pre.code[data-output][data-label="HTML"]
                }
                a.open[href="playground.html"]: "플레이그라운드에서 열기 →"
            }
        }
    }

    section#start.block.wrap {
        .section-head {
            h2: "시작하기"
            p: "Node.js 20 이상이 필요합니다."
        }
        .start {
            div {
                h3: "1. 설치"
                pre.code {
                    `
                    git clone https://github.com/614project/weber.git
                    cd weber
                    npm install
                    npm link
                    `
                }
            }
            div {
                h3: "2. index.weber 쓰기"
                pre.code[data-weber] {
                    `
                    title: "안녕"
                    h1: "안녕, weber!"
                    `
                }
                h3: "3. 변환"
                pre.code: "weber index.weber   # → index.html"
            }
        }
    }
}

footer.site {
    .wrap {
        span { "이 사이트도 weber 로 만들었습니다 · "; a[href="https://github.com/614project/weber/tree/main/introduce"]: "소스 보기" }
        span { "MIT © 614project · "; span[data-version]: "weber" }
    }
}

script[type=module]: index.js
