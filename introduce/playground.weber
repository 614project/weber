// weber 플레이그라운드 — 이 파일도 weber 로 쓰였습니다.
// 편집기 동작은 playground.js, 예제는 examples.js 에 있습니다.

lang ko
title: "플레이그라운드 — weber"
viewport "width=device-width, initial-scale=1"
description "브라우저에서 바로 weber 코드를 써 보고 HTML 로 변환해 보세요."
theme-color "#6c4cf1"
icon favicon.svg

// 머리글, 색, 코드 블록 스타일은 index.weber 와 같습니다. 고칠 때 함께 고치세요.
style {
    :root {
        --bg #fbfaff
        --surface #ffffff
        --ink #1d1b2e
        --muted #625f78
        --line #e8e5f4
        --accent #6c4cf1
        --accent-ink #ffffff
        --accent-soft #efeaff
        --code-bg #19172b
        --code-ink #e9e7f5
        --code-line #2c2945
        --k-element #c3a6ff
        --k-attribute #ffb86b
        --k-css #5fd0ef
        --k-js #8fe388
        --t-string #e2d3a6
        --t-comment #8c88a8
        --mono ui-monospace, "SF Mono", "JetBrains Mono", D2Coding, Menlo, Consolas, monospace
        color-scheme light dark
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --bg #0f0e18
            --surface #17152a
            --ink #ecebf6
            --muted #a6a3bd
            --line #2a2742
            --accent #a28cff
            --accent-ink #160f33
            --accent-soft #241e44
            --code-bg #1b1930
            --code-line #302c4c
        }
    }

    * { box-sizing border-box }
    body {
        display flex
        flex-direction column
        min-height 100vh
        margin 0
        background var(--bg)
        color var(--ink)
        font-family Pretendard, system-ui, -apple-system, "Apple SD Gothic Neo", "Noto Sans KR", sans-serif
        line-height 1.6
        word-break keep-all
        -webkit-font-smoothing antialiased
        @media (min-width: 901px) { height 100vh; height 100dvh }
    }
    .wrap { max-width 1080px; margin 0 auto; padding 0 20px }

    header.site {
        flex none
        background var(--bg)
        border-bottom 1px solid var(--line)
        nav { display flex; align-items center; gap 24px; height 60px }
        .wrap { max-width none }
        .logo {
            display flex
            align-items center
            gap 8px
            color var(--ink)
            font-size 20px
            font-weight 800
            text-decoration none
            svg { color var(--accent) }
        }
        .links {
            display flex
            gap 20px
            margin-left auto
            a {
                color var(--muted)
                font-size 15px
                text-decoration none
                &:hover { color var(--ink) }
                &[aria-current=page] { color var(--accent); font-weight 600 }
            }
        }
    }

    .k-element { color var(--k-element) }
    .k-attribute { color var(--k-attribute) }
    .k-css { color var(--k-css) }
    .k-js { color var(--k-js) }
    .t-string { color var(--t-string) }
    .t-comment, .t-punct { color var(--t-comment) }
    .t-comment { font-style italic }
    .err {
        background rgb(255 90 90 / 22%)
        text-decoration underline wavy #ff6b6b
        text-decoration-skip-ink none
    }
    .legend {
        display flex
        flex-wrap wrap
        gap 4px 14px
        font-size 12px
        span::before {
            content ""
            display inline-block
            width 9px
            height 9px
            margin-right 5px
            border-radius 3px
            background currentColor
        }
    }

    main.playground {
        display flex
        flex 1
        flex-direction column
        gap 12px
        min-height 0
        padding 14px 20px 20px
    }

    .toolbar {
        display flex
        flex-wrap wrap
        align-items center
        gap 8px 10px
        label { display inline-flex; align-items center; gap 6px; color var(--muted); font-size 14px }
        select, button {
            height 36px
            padding 0 14px
            border 1px solid var(--line)
            border-radius 10px
            background var(--surface)
            color var(--ink)
            font inherit
            font-size 14px
            cursor pointer
        }
        button:hover, select:hover { border-color var(--accent) }
        button.primary { background var(--accent); border-color var(--accent); color var(--accent-ink); font-weight 600 }
        input[type=checkbox] { width 16px; height 16px; accent-color var(--accent) }
        .spacer { flex 1 }
        @media (max-width: 600px) {
            .spacer { display none }
            button { flex 1; padding 0 8px }
        }
    }

    .panes {
        display grid
        flex 1
        grid-template-columns 1fr 1fr
        gap 14px
        min-height 0
        @media (max-width: 900px) {
            grid-template-columns 1fr
            grid-auto-rows minmax(440px, 62vh)
        }
    }
    .pane {
        display flex
        flex-direction column
        min-width 0
        min-height 0
        overflow hidden
        border 1px solid var(--code-line)
        border-radius 16px
        background var(--code-bg)
        color var(--code-ink)
    }
    .pane-head {
        display flex
        flex none
        align-items center
        justify-content space-between
        gap 12px
        min-height 46px
        padding 6px 14px
        border-bottom 1px solid var(--code-line)
        h2 { margin 0; font-size 14px; font-weight 700 }
    }

    .editor {
        position relative
        flex 1
        min-height 0
        pre, textarea {
            position absolute
            inset 0
            width 100%
            height 100%
            margin 0
            padding 16px 18px
            border 0
            font 14px/1.65 var(--mono)
            letter-spacing 0
            tab-size 4
            white-space pre
            overflow auto
        }
        pre { overflow hidden; pointer-events none }
        textarea {
            resize none
            outline none
            background transparent
            color transparent
            -webkit-text-fill-color transparent
            caret-color #ffffff
            &::selection { background rgb(162 140 255 / 38%) }
        }
    }

    .status {
        flex none
        max-height 34%
        overflow auto
        padding 9px 14px
        border-top 1px solid var(--code-line)
        color var(--t-comment)
        font-size 13px
        .ok { color var(--k-js); font-weight 600 }
        .bad { color #ff8f8f; font-weight 600 }
        ul { margin 6px 0 0; padding 0; list-style none }
        button {
            padding 0
            border 0
            background none
            color var(--k-attribute)
            font inherit
            text-align left
            cursor pointer
            &:hover { text-decoration underline }
        }
    }

    .tabs {
        display flex
        gap 4px
        button {
            padding 5px 12px
            border 0
            border-radius 8px
            background none
            color var(--t-comment)
            font inherit
            font-size 14px
            cursor pointer
            &[aria-selected=true] { background var(--code-line); color var(--code-ink); font-weight 600 }
        }
    }
    iframe#preview { flex 1; width 100%; border 0; background white }
    pre#html-view {
        flex 1
        margin 0
        padding 16px 18px
        overflow auto
        font 13px/1.6 var(--mono)
        tab-size 4
    }
    [hidden] { display none !important }

    #toast {
        position fixed
        left 50%
        bottom 28px
        padding 10px 18px
        border-radius 999px
        background var(--ink)
        color var(--bg)
        font-size 14px
        opacity 0
        transform translate(-50%, 12px)
        transition opacity .2s, transform .2s
        pointer-events none
        &.show { opacity 1; transform translate(-50%, 0) }
    }
}

header.site {
    nav.wrap {
        a.logo[href="./"] {
            svg {
                width 26
                height 26
                viewBox "0 0 24 24"
                fill currentColor
                aria-hidden true
                path: "M3 3.5h18v4.5H3zM5.5 10h13v4.5h-13zM8 16.5h8V21H8z"
            }
            "weber"
        }
        .links {
            a[href="./"]: "소개"
            a[href="playground.html"][aria-current=page]: "플레이그라운드"
            a[href="https://github.com/614project/weber"]: "GitHub"
        }
    }
}

main.playground {
    .toolbar {
        label {
            "예제"
            select#examples[aria-label="예제 고르기"]
        }
        label {
            input#minify[type=checkbox]
            "압축 출력"
        }
        span.spacer
        button#share.primary[title="지금 코드를 담은 주소를 복사합니다"]: "공유 링크"
        button#copy[title="변환된 HTML 을 복사합니다"]: "HTML 복사"
        button#download[title="미리보기와 같은 HTML 파일을 내려받습니다"]: "내려받기"
    }

    .panes {
        section.pane {
            .pane-head {
                h2: "weber"
                .legend {
                    span.k-element: "요소"
                    span.k-attribute: "속성"
                    span.k-css: "CSS"
                    span.k-js: "JS"
                }
            }
            .editor {
                pre#highlight[aria-hidden=true]
                textarea#source[spellcheck=false][autocomplete=off][autocapitalize=off][wrap=off][aria-label="weber 코드"]
            }
            #status.status[role=status][aria-live=polite]: "불러오는 중..."
        }
        section.pane {
            .pane-head {
                .tabs[role=tablist] {
                    button#tab-preview[role=tab][aria-selected=true]: "미리보기"
                    button#tab-html[role=tab][aria-selected=false]: "HTML"
                }
                .legend#mode-label
            }
            iframe#preview[title="미리보기"][sandbox="allow-scripts allow-modals allow-forms"]
            pre#html-view[hidden]
        }
    }
}

#toast[role=status]

script[type=module]: playground.js
